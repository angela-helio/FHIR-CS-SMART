# Veradigm/Allscripts SMART on FHIR Configuration
# Copy this file to .env and fill in your actual values

# Veradigm OAuth Credentials (obtain from Veradigm Connect portal)
VERADIGM_CLIENT_ID=your_actual_client_id_here
VERADIGM_CLIENT_SECRET=your_actual_client_secret_here

# Redirect URI Configuration
SMART_REDIRECT_URI=http://127.0.0.1:8080/callback
PRODUCTION_REDIRECT_URI=https://yourdomain.com/callback

# ngrok Configuration (for local development)
# Update with your ngrok URL when testing with external EHR systems
NGROK_URL=https://your-ngrok-url.ngrok.io

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Backend Service Authentication (for System-type apps)
BACKEND_AUTH_ENABLED=false
BACKEND_SCOPES=system/*.read
JWKS_KEY_ID=your_key_id_here

# Optional: Override FHIR Base URL if needed
# FHIR_BASE_URL=https://fhir.fhirpoint.open.allscripts.com/fhirroute/fhir/CP00101/
